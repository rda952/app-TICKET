{
  "name": "ticket-copilot",
  "version": "1.0.0",
  "description": "Copilote Discord pour groupes de revente de billets : fiches événement, réponses automatiques, résumé quotidien",
  "scripts": {
    "bot": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/bot.ts",
    "import": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/cli/import.ts",
    "ask": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/cli/ask.ts",
    "fiches": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/cli/fiches.ts",
    "typecheck": "tsc",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rda952/app-TICKET.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/rda952/app-TICKET/issues"
  },
  "homepage": "https://github.com/rda952/app-TICKET#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "discord.js": "^14.27.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}
