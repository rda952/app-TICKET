# Clé API Claude (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# Token du bot (https://discord.com/developers/applications → ton app → Bot → Reset Token)
DISCORD_TOKEN=

# IDs de salons séparés par des virgules (Discord → Paramètres → Avancés → Mode développeur, puis clic droit sur un salon → Copier l'identifiant)
# Salons que le bot lit pour remplir les fiches (infos, talk, annonces…)
WATCHED_CHANNEL_IDS=
# Salons où le bot répond tout seul aux questions (ex. #questions). Ils sont aussi lus.
QUESTION_CHANNEL_IDS=
# Salon où poster le résumé quotidien (laisser vide pour désactiver)
DIGEST_CHANNEL_ID=
# Heure du résumé (0-23, heure du serveur qui fait tourner le bot)
DIGEST_HOUR=9

# Rôles qui peuvent valider/ajouter des infos (les admins du serveur le peuvent toujours)
STAFF_ROLE_IDS=

# Optionnel
# CLAUDE_MODEL=claude-opus-5-5
# EXTRACT_EVERY_MINUTES=10
# DB_PATH=data/copilot.db
